startgroup
    animation_step 0

    var float WARP = 0
    var float SCAN = 2
    var float4 TINT = float4(1.0, 0.0, 0.025, 0.3)

    shaders crt
endgroup

startgroup
    animation_step 0

    var float BLOOM_STRENGTH = 0.1
    var float BLOOM_THRESHOLD = 0.2
    shaders bloom
endgroup

startgroup
    animation_step 0
    animation_start cursor-trail-move
    animation_stop cursor-trail-stop

    var float4 TRAIL_COLOR = float4(0.584314, 0.0, 0.082353, 1.0);
    shaders cursor-trail-blaze
endgroup

startgroup
    animation_start tab-change
    animation_stop 600
    animation_curve ease-out
    animation_step 16
    var int ANIMATION_TYPE = 1

    shaders tab-change
endgroup
